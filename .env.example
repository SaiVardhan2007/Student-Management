# Copy to .env.local and adjust. Never commit .env.local.

# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/student_management

# Generate long random values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Public address of the app (used in password-reset links)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Student Management System

# Where uploads live: 'disk' (default, UPLOAD_DIR below) or 'gridfs' (inside MongoDB — for free hosts without a persistent disk)
STORAGE=disk
# Local file uploads (relative to the project root, or absolute)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Set to true once the site is served over HTTPS
COOKIE_SECURE=false
# Reverse-proxy hops in front of the app (0 = none) — used to read the client IP
TRUST_PROXY=0

# SMTP (outgoing email: password reset links, faculty approval notices). Leave SMTP_HOST empty in development:
# mails are then printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Student Management System <no-reply@example.com>"

# Razorpay (fee payments). Use rzp_test_ keys for testing; leave empty to disable online payment.
# The webhook secret is the one you set when adding the webhook (<APP_URL>/api/fees/razorpay/webhook, event payment.captured).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Rate limits (requests per 15 minutes): auth routes / all API routes
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=1000
# Account lockout after repeated failed logins
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Password used for seeded development accounts (dev only)
SEED_PASSWORD=ChangeMe@123
# Demo servers only: allow `npm run seed` when NODE_ENV=production
ALLOW_DEMO_SEED=false

# First administrator (npm run create-admin)
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
