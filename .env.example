# Used by docker-compose.yml. Copy to .env and fill in the secrets. NEVER commit the real .env.

# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Public address people type into the browser (used for CORS and password-reset links)
CLIENT_URL=http://localhost:5000
APP_PORT=5000

# Set to true once the site is served over HTTPS (e.g. behind Caddy/nginx with TLS)
COOKIE_SECURE=false
# Number of reverse proxies in front of the app (0 when exposed directly)
TRUST_PROXY=1

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
MAX_FILE_SIZE_MB=10
MONGO_DB=student_management

# First administrator (used by: docker compose run --rm tools)
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Demo deployments only: allows `npm run seed` in production mode
ALLOW_DEMO_SEED=false
SEED_PASSWORD=
