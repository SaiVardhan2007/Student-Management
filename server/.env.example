# Copy to .env and adjust. Never commit the real .env file.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/student_management
MONGODB_URI_TEST=mongodb://localhost:27017/student_management_test
CLIENT_URL=http://localhost:5173

# Generate long random values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Local file uploads (relative to server/ or absolute)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Set to true to let Express serve client/dist (production-style local run)
SERVE_CLIENT=false

# Password used for seeded development accounts (dev only)
SEED_PASSWORD=ChangeMe@123
